generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// User model - Stores user profile data
/// The id matches the Supabase Auth user id for easy lookups
model User {
  id                String                @id @default(uuid())
  email             String                @unique
  passwordHash      String
  role              String                @default("anonymous")
  status            String                @default("active")
  firstName         String?
  lastName          String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  // Relations for communities
  communitiesOwned      Community[]                @relation("CommunityOwner")
  communityMembers      CommunityMember[]
  joinRequests          CommunityJoinRequest[]
  discussions           CommunityDiscussion[]
  claimedIssues         CommunityClaimedIssue[]   @relation("ClaimedIssuesAsModerator")

  @@map("users")
}

/// Community model - Stores community information for volunteer coordination
model Community {
  id            String                  @id @default(uuid())
  ownerId       String
  name          String
  description   String?
  location      String
  coverageType  String                  @default("neighborhood") // "neighborhood", "district", "city"
  guidelines    String?
  imageUrl      String?
  status        String                  @default("active") // "active", "inactive", "archived"
  memberCount   Int                     @default(1)
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  owner         User                    @relation("CommunityOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members       CommunityMember[]
  joinRequests  CommunityJoinRequest[]
  discussions   CommunityDiscussion[]
  claimedIssues CommunityClaimedIssue[]

  @@index([ownerId])
  @@index([status])
  @@map("communities")
}

/// CommunityMember model - Maps users to communities with roles
model CommunityMember {
  id          String    @id @default(uuid())
  userId      String
  communityId String
  role        String    @default("member") // "owner", "moderator", "member"
  joinedAt    DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@unique([userId, communityId])
  @@index([userId])
  @@index([communityId])
  @@map("community_members")
}

/// CommunityJoinRequest model - Tracks join requests from users
model CommunityJoinRequest {
  id          String    @id @default(uuid())
  userId      String
  communityId String
  status      String    @default("pending") // "pending", "approved", "rejected"
  message     String?
  requestedAt DateTime  @default(now())
  respondedAt DateTime?

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@unique([userId, communityId])
  @@index([userId])
  @@index([communityId])
  @@index([status])
  @@map("community_join_requests")
}

/// CommunityDiscussion model - Stores community discussion messages
model CommunityDiscussion {
  id          String    @id @default(uuid())
  communityId String
  userId      String
  message     String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([communityId])
  @@index([userId])
  @@index([createdAt])
  @@map("community_discussions")
}

/// CommunityClaimedIssue model - Tracks waste reports claimed by communities
model CommunityClaimedIssue {
  id          String    @id @default(uuid())
  communityId String
  issueId     String    // External ID from reporting system
  claimedBy   String    // User ID of moderator who claimed it
  status      String    @default("active") // "active", "completed", "cancelled"
  claimedAt   DateTime  @default(now())
  completedAt DateTime?

  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  claimedByUser User    @relation("ClaimedIssuesAsModerator", fields: [claimedBy], references: [id], onDelete: Cascade)

  @@unique([communityId, issueId])
  @@index([communityId])
  @@index([issueId])
  @@index([status])
  @@map("community_claimed_issues")
}
